<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ✅ MOVED OUTSIDE - Internet permission must be here -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TipidMate"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- ✅ SignupActivity is now the MAIN launcher -->
        <activity
            android:name=".SignupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LoginActivity - accessible from signup screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Other Activities -->
        <activity
            android:name=".HomeScreenActivity"
            android:exported="false" />

        <activity
            android:name=".TransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".ChartsActivity"
            android:exported="false" />

        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".GroupBudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".AllTransactionsActivity"
            android:exported="false" />

        <activity
            android:name=".BudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".GoalsCreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".GoalsDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".GoalsSavingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"/>

        <activity
            android:name=".AllContributionsActivity"
            android:exported="false" />

        <activity
            android:name=".NewGroupBudgetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".GroupBudgetDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".GroupBudgetAddActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".GroupBudgetHistoryActivity"
            android:exported="false" />

    </application>

</manifest>